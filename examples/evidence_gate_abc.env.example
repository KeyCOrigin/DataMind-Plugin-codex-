# Merge into your existing DataMind environment; keep your current LLM credentials.
DATAMIND__AGENT__MODE=evidence_gated
DATAMIND__EVIDENCE_GATE__SCORING_MODE=abc
DATAMIND__EVIDENCE_GATE__ATOM_SUPPORT_THRESHOLD=0.3
DATAMIND__EVIDENCE_GATE__ATOM_REFUTE_THRESHOLD=-0.3
DATAMIND__EVIDENCE_GATE__MIN_SUPPORT_RATIO=0.8
DATAMIND__EVIDENCE_GATE__REQUIRE_FINAL_SUPPORT=false
DATAMIND__EVIDENCE_GATE__SCORING_DISABLE_THINKING=true
# DATAMIND__EVIDENCE_GATE__SCORING_MODEL=your-logprob-capable-model
# DATAMIND__EVIDENCE_GATE__SCORING_API_BASE=https://your-gateway/v1
# DATAMIND__EVIDENCE_GATE__SCORING_API_KEY=your-key
